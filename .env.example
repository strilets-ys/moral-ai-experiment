# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM API Keys (at minimum, set ONE of these for testing)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
QWEN_API_KEY=your-qwen-key-here

# Qwen base URL (optional - this is the default)
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Prolific completion URL (not needed for standalone testing)
# PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=YOURCODE
